#!/bin/bash
#SBATCH --job-name=recert
#SBATCH --account=lia@cpu
#SBATCH --partition=cpu_p1
#SBATCH --qos=qos_cpu-t3
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --hint=nomultithread
#SBATCH --time=20:00:00
#SBATCH --output=KInduceDFS/jz_reproduce/slurm/recert_%j.out
#SBATCH --error=KInduceDFS/jz_reproduce/slurm/recert_%j.out
#
# FULL re-certification on foreign hardware -- the gold standard.  The instance
# is DATA: everything that differs between campaigns lives in
# instances/<name>.conf (size, margin, base, arc/non, expected roots, cost), so
# this file is identical for every campaign and adding one changes nothing here.
#
#   INSTANCE=p19    ~24 core-h
#   INSTANCE=p23   ~228 core-h
# (see COMMANDS.md for the submit line)
#
# ROOT (CNF) MUST match -- it commits to WHICH problems were solved, and is
# generated by this repository's code with no solver involved.
# ROOT (proofs) will NOT match, and that is expected rather than a failure: a
# different cadical version, architecture or optimisation level may search
# differently and emit a different, EQUALLY VALID proof.  run.sh compares only
# the former.
#
# A SAT cube would be a WITNESS and a major result: the run stops and keeps the
# instance as STOP_SAT.  Do not dismiss that as a porting artifact.
#
# NO --mem: Jean-Zay rejects it; RAM is proportional to --cpus-per-task.
# Submit FROM THE REPO ROOT.
set -u
mkdir -p KInduceDFS/jz_reproduce/slurm
KInduceDFS/jz_reproduce/run.sh "${INSTANCE:-p19}" recertify
